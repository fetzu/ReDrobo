<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app ask the system to activate the driver it carries. -->
	<key>com.apple.developer.system-extension.install</key>
	<true/>

	<!--
	  Opening the driver's user client used to be authorised from here, with
	  userclient-access naming the driver. That capability is managed and Apple
	  has not granted it yet, so the driver carries allow-any-userclient-access
	  instead (see DroboDext.entitlements for the full reasoning).

	  Put this back, and take that one out, once the request comes through:

		<key>com.apple.developer.driverkit.userclient-access</key>
		<array>
			<string>org.redrobo.ReDrobo.DroboDext</string>
		</array>
	-->
</dict>
</plist>
