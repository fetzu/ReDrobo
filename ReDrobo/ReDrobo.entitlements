<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app ask the system to activate the driver it carries. -->
	<key>com.apple.developer.system-extension.install</key>
	<true/>

	<!--
	  Granted by Apple on 2026-09-10, so the permission is back where it
	  belongs: one app, named here, may open the driver's user client, and
	  nothing else on the machine may. The driver carried
	  allow-any-userclient-access for as long as the request was pending, which
	  was the loose version of the same thing.

	  Portal capability: "DriverKit UserClient Access", ticked on this App ID
	  rather than the driver's, configured with the driver's bundle ID.

	  Both profiles have to grant it before this can be signed, so the
	  development pair needs regenerating as well as the Developer ID pair. Sign
	  against a profile that does not grant it and AMFI SIGKILLs the app at
	  exec, which reads as "Taskgated Invalid Signature" and looks like a broken
	  signature rather than a missing capability.
	-->
	<key>com.apple.developer.driverkit.userclient-access</key>
	<array>
		<string>org.redrobo.ReDrobo.DroboDext</string>
	</array>
</dict>
</plist>
